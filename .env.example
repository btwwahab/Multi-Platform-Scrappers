DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=mydb

# Request-based DB selection (used by npm run scrape:url:server)
# Routing is strict: the request domain must match a configured domain.
LOCAL_DOMAINS=localhost,127.0.0.1
DEV_DOMAINS=dev.virtualassistants.help
STAGING_DOMAINS=stage.virtualassistants.help
PROD_DOMAINS=virtualassistant.market,www.virtualassistant.market

# Development DB on server
DEV_DB_HOST=dev-db.example.com
DEV_DB_PORT=5432
DEV_DB_USER=postgres
DEV_DB_PASSWORD=your_dev_password_here
DEV_DB_NAME=mydb_dev

# Staging DB on server
STAGING_DB_HOST=staging-db.example.com
STAGING_DB_PORT=5432
STAGING_DB_USER=postgres
STAGING_DB_PASSWORD=your_staging_password_here
STAGING_DB_NAME=mydb_staging

# Production DB on server
PROD_DB_HOST=prod-db.example.com
PROD_DB_PORT=5432
PROD_DB_USER=postgres
PROD_DB_PASSWORD=your_prod_password_here
PROD_DB_NAME=mydb_prod
CHROME_PATH=/usr/bin/google-chrome-stable
SCRAPE_HOST=0.0.0.0
SCRAPE_PORT=8787

# ── Webshare Proxy Configuration ──────────────────────────────────────────────
# PROXY_MODE controls how proxies are used:
#   rotate  → Use Webshare's rotating gateway (default, recommended)
#             username: virtualassistants-rotate  (auto-rotates on every request)
#   list    → Round-robin through the 10 static proxies sequentially
#             usernames: virtualassistants-1 … virtualassistants-10
#   none    → Disable all proxies (useful for local dev / debugging)
PROXY_MODE=rotate

# Your Webshare proxy password (same for all users)
PROXY_PASSWORD=vpassword

# Webshare proxy endpoint (no need to change)
PROXY_HOST=p.webshare.io
PROXY_PORT=80

# Username prefix (proxies will be <PREFIX>-1 … <PREFIX>-<COUNT> and <PREFIX>-rotate)
PROXY_USER_PREFIX=virtualassistants

# Number of static proxies in the list (used when PROXY_MODE=list)
PROXY_COUNT=10

# Google Maps static proxy pool used by src/network/scrape-google-maps-network.js
# Format: [["host","port","username","password"], ...]
GMAPS_PROXY_POOL=[["proxy-host-1","port","username","password"],["proxy-host-2","port","username","password"]]

GMAPS_USE_PROXY=1
CLUTCH_USE_PROXY=1